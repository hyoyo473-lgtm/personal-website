# ==============================================================================
# 智慧校園 學生常規優缺點管理系統 - 環境變數設定範本 (.env.example)
# ==============================================================================
# 說明：
# 請複製此檔案為 .env 並填入您的 Google Apps Script 後端網址。
# 網址取得方式請參閱 README.md 中的「Google Apps Script 雲端資料庫設定教學」。
# 格式範例：https://script.google.com/macros/s/AKfycb.../exec (結尾必須為 /exec)
# ==============================================================================

# Google Apps Script 雲端同步後端 Web App 連結
GOOGLE_APP_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzrYm9sOZ5Ff13Vg8RF4SZkX4rkuqnz60_7cl0XZ39Vc3G-WQi2LjJi2DP0rBHoBjk_/exec
